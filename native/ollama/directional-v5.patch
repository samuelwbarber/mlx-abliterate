+
+func TestValidateUnitDirection(t *testing.T) {
+	for _, v := range [][]float32{{0, 0}, {2, 0}, {float32(math.NaN()), 0}, {float32(math.Inf(1)), 0}, {1}} {
+		if ValidateUnitDirection(v, 2) == nil {
+			t.Fatalf("accepted %v", v)
+		}
+	}
+	if err := ValidateUnitDirection([]float32{0.6, 0.8}, 2); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type fixedDirectionalBase struct{ output *mlx.Array }
+
+func (f *fixedDirectionalBase) Forward(*mlx.Array) *mlx.Array { return f.output }
+func (*fixedDirectionalBase) OutputDim() int32                { return 2 }
+
+func TestDirectionalZeroReturnsExactHandle(t *testing.T) {
+	output := &mlx.Array{}
+	wrapper := &DirectionalLinear{Base: &fixedDirectionalBase{output: output}, Strength: 0}
+	if wrapper.Forward(nil) != output {
+		t.Fatal("zero did not return original handle")
+	}
+}
+
+func TestDirectionalArithmeticAndBias(t *testing.T) {
+	mlxtest.Run(t, func(t *mlxtest.T) {
+		weights := mlx.FromValues([]float32{1, 0, 0, 1}, 2, 2)
+		bias := mlx.FromValues([]float32{4, 5}, 2)
+		base := NewLinear(weights, bias)
+		direction := mlx.FromValues([]float32{1, 0}, 2)
+		wrapper, err := NewDirectionalLinear(base, direction, 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		collected := mlx.Collect(wrapper)
+		foundScale := false
+		for _, a := range collected {
+			if a == wrapper.Scale {
+				foundScale = true
+			}
+		}
+		if !foundScale {
+			t.Fatal("scale is not retained by model scope")
+		}
+		input := mlx.FromValues([]float32{2, 3, 7, 11}, 2, 2)
+		got := wrapper.Forward(input).Floats()
+		want := []float32{4, 8, 4, 16}
+		for i := range want {
+			if got[i] != want[i] {
+				t.Fatalf("got %v want %v", got, want)
+			}
+		}
+		if _, err := NewDirectionalLinear(base, mlx.FromValues([]float32{2, 0}, 2), 1); err == nil {
+			t.Fatal("accepted nonunit direction")
+		}
+		if _, err := NewDirectionalLinear(base, direction, 3); err == nil {
+			t.Fatal("accepted strength3")
+		}
+
+	})
+}
+
+func TestDirectionalMetalMatchesUnfused(t *testing.T) {
+	mlxtest.Run(t, func(t *mlxtest.T) {
+		mlx.EnableCompile()
+		for _, rows := range []int{1, 2, 9, 32} {
+			values := make([]float32, rows*5120)
+			directions := make([]float32, 5120)
+			for i := range values {
+				values[i] = float32(math.Sin(float64(i) * 0.17))
+			}
+			for i := range directions {
+				directions[i] = float32(math.Cos(float64(i) * 0.11))
+			}
+			d := mlx.FromValues(directions, 5120)
+			d = d.Divide(d.Multiply(d).SumAxis(0, false).Sqrt())
+			scale := mlx.NewScalarArray(float32(1.575))
+			for _, dtype := range []mlx.DType{mlx.DTypeFloat32, mlx.DTypeBFloat16} {
+				out := mlx.FromValues(values, rows, 5120).AsType(dtype)
+				value := out.AsType(mlx.DTypeFloat32)
+				coefficient := value.Multiply(d).SumAxis(-1, true)
+				want := out.Subtract(scale.Multiply(coefficient).Multiply(d).AsType(dtype))
+				got := mlx.DirectionalCorrection(out, d, scale)
+				difference := got.AsType(mlx.DTypeFloat32).Subtract(want.AsType(mlx.DTypeFloat32)).Abs().Reshape(-1).MaxAxis(0, false).Floats()[0]
+				limit := float32(1e-6)
+				if dtype == mlx.DTypeBFloat16 {
+					limit = 0.0078125
+				}
+				if difference > limit {
+					t.Fatalf("Metal correction drift %g exceeds %g", difference, limit)
+				}
+				residual := out.Multiply(mlx.NewScalarArray(float32(0.3))).AsType(dtype)
+				wantResidual := mlx.Add(residual, want)
+				gotResidual := mlx.DirectionalCorrectionResidual(out, d, scale, residual)
+				drift := gotResidual.AsType(mlx.DTypeFloat32).Subtract(wantResidual.AsType(mlx.DTypeFloat32)).Abs().Reshape(-1).MaxAxis(0, false).Floats()[0]
+				if drift > limit {
+					t.Fatalf("residual correction drift %g exceeds %g", drift, limit)
+				}
+
+			}
+		}
+	})
+}
