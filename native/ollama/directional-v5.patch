+package create
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/ollama/ollama/mlxrunner"
+)
+
+func TestDirectionalArchitectureImportPolicy(t *testing.T) {
+	const arch = "Qwen3_5DirectionalForConditionalGeneration"
+	if !mlxrunner.SupportsArchitecture(arch) {
+		t.Fatal("custom architecture not registered")
+	}
+	factory, ok := tensorImportTransformRegistry[arch]
+	if !ok {
+		t.Fatal("missing Qwen import policy")
+	}
+	policy, err := factory(json.RawMessage(`{}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := policy.(qwen35ImportTransform); !ok {
+		t.Fatal("custom architecture must retain Qwen import policy")
+	}
+}
diff --git a/mlx/directional.go b/mlx/directional.go
new file mode 100644
index 0000000..c463d35
--- /dev/null
+++ b/mlx/directional.go
@@ -0,0 +1,123 @@
+package mlx
+
+/*
+#include "generated.h"
+#include <limits.h>
+
+// Keep descriptor construction, validation and dispatch within one CGo call.
+// This avoids dozens of Go/C crossings per edited projection and stores no
+// unbounded shape cache. Every temporary handle is released on all paths.
+static int directional_apply(mlx_array *res, mlx_fast_metal_kernel kernel,
+    mlx_array x, mlx_array direction, mlx_array scale, mlx_array residual, int add_residual, mlx_stream stream) {
+  size_t ndim = mlx_array_ndim(x);
+  if (!ndim || mlx_array_ndim(direction) != 1 ||
+      mlx_array_dtype(direction) != MLX_FLOAT32 ||
+      mlx_array_ndim(scale) != 0 || mlx_array_dtype(scale) != MLX_FLOAT32) return -1;
+  const int *shape = mlx_array_shape(x);
+  int width = mlx_array_dim(direction, 0);
+  mlx_dtype dtype = mlx_array_dtype(x);
+  if (width <= 0 || shape[ndim - 1] != width ||
+      (dtype != MLX_BFLOAT16 && dtype != MLX_FLOAT32)) return -1;
+  if (add_residual) {
+    if (mlx_array_dtype(residual) != dtype || mlx_array_ndim(residual) != ndim) return -1;
+    const int *res_shape = mlx_array_shape(residual);
+    for (size_t i = 0; i < ndim; ++i) if (res_shape[i] != shape[i]) return -1;
+  }
+  size_t rows = mlx_array_size(x) / width;
+  if (!rows || rows > INT_MAX / 256) return -1;
+  mlx_fast_metal_kernel_config cfg = mlx_fast_metal_kernel_config_new();
+  if (!cfg.ctx) return -1;
+  mlx_array args[] = {x, direction, scale, residual};
+  mlx_vector_array inputs = mlx_vector_array_new_data(args, 4);
+  mlx_vector_array outputs = mlx_vector_array_new();
+  int status = -1;
+  if (!inputs.ctx || !outputs.ctx) goto cleanup;
+  status = mlx_fast_metal_kernel_config_add_template_arg_dtype(cfg, "InT", dtype);
+  if (status) goto cleanup;
+  status = mlx_fast_metal_kernel_config_add_template_arg_int(cfg, "Width", width);
+  if (status) goto cleanup;
+  status = mlx_fast_metal_kernel_config_add_template_arg_int(cfg, "AddResidual", add_residual);
+  if (status) goto cleanup;
+  status = mlx_fast_metal_kernel_config_add_output_arg(cfg, shape, ndim, dtype);
+  if (status) goto cleanup;
+  status = mlx_fast_metal_kernel_config_set_grid(cfg, (int)rows * 256, 1, 1);
+  if (status) goto cleanup;
+  status = mlx_fast_metal_kernel_config_set_thread_group(cfg, 256, 1, 1);
+  if (status) goto cleanup;
+  status = mlx_fast_metal_kernel_apply(&outputs, kernel, inputs, cfg, stream);
+  if (status) goto cleanup;
+  if (mlx_vector_array_size(outputs) != 1) { status = -1; goto cleanup; }
+  status = mlx_vector_array_get(res, outputs, 0);
+cleanup:
+  if (inputs.ctx) { int e = mlx_vector_array_free(inputs); if (!status) status = e; }
+  if (outputs.ctx) { int e = mlx_vector_array_free(outputs); if (!status) status = e; }
+  mlx_fast_metal_kernel_config_free(cfg);
+  return status;
+}
+*/
+import "C"
+
+// One threadgroup reduces each output row, then applies the rank-one edit.
+// Intermediate correction rounding matches the graph's cast-before-subtract.
+const directionalMetalSource = `
+uint tid = thread_position_in_threadgroup.x;
+uint lane = tid % 32;
+uint warp = tid / 32;
+uint row = threadgroup_position_in_grid.x;
+threadgroup float partial[8];
+float acc = 0.0f;
+for (uint c = tid; c < Width; c += 256) {
+  float product = float(x[row * Width + c]) * direction[c];
+  acc += product;
+}
+acc = simd_sum(acc);
+if (lane == 0) partial[warp] = acc;
+threadgroup_barrier(mem_flags::mem_threadgroup);
+float total = lane < 8 ? partial[lane] : 0.0f;
+total = simd_sum(total);
+float scaled = scale * total;
+for (uint c = tid; c < Width; c += 256) {
+  InT correction = InT(scaled * direction[c]);
+  InT corrected = InT(float(x[row * Width + c]) - float(correction));
+  if (AddResidual) corrected = InT(float(residual[row * Width + c]) + float(corrected));
+  out[row * Width + c] = corrected;
+}
+`
+
+var directionalMetal = &gpuKernel{
+	name:    "directional_rank_one",
+	inputs:  []string{"x", "direction", "scale", "residual"},
+	outputs: []string{"out"},
+	metal:   gpuSource{source: directionalMetalSource},
+}
+
+// DirectionalCorrection requires the Metal backend; unsupported execution
+// fails explicitly rather than silently switching to CPU.
+func DirectionalCorrection(x, direction, scale *Array) *Array {
+	return directionalCorrectionWithResidual(x, direction, scale, nil)
+}
+
+func DirectionalCorrectionResidual(x, direction, scale, residual *Array) *Array {
+	if residual == nil {
+		panic("mlx.DirectionalCorrectionResidual: missing residual")
+	}
+	return directionalCorrectionWithResidual(x, direction, scale, residual)
+}
+
+func directionalCorrectionWithResidual(x, direction, scale, residual *Array) *Array {
+	if x == nil || direction == nil || scale == nil {
+		panic("mlx.DirectionalCorrection: missing array")
+	}
+	kernel, ok := directionalMetal.getMetal()
+	if !ok {
+		panic("mlx.DirectionalCorrection: Metal kernel unavailable")
+	}
+	addResidual := C.int(1)
+	if residual == nil {
+		residual = x
+		addResidual = 0
+	}
+	out := New("DIRECTIONAL_CORRECTION")
+	mlxCheck(C.directional_apply(&out.ctx, kernel, x.ctx, direction.ctx, scale.ctx, residual.ctx, addResidual, DefaultStream().ctx))
+	return out
+}
diff --git a/mlxrunner/model/qwen3_5/directional.go b/mlxrunner/model/qwen3_5/directional.go
new file mode 100644
index 0000000..6d44244
--- /dev/null
+++ b/mlxrunner/model/qwen3_5/directional.go
@@ -0,0 +1,163 @@
+package qwen3_5
+
+// Original format extension for weight-preserving rank-one output edits.
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+
+	"github.com/ollama/ollama/mlx"
+	"github.com/ollama/ollama/mlxrunner/nn"
+)
+
+const directionalArchitecture = "Qwen3_5DirectionalForConditionalGeneration"
+const directionTensorPrefix = "mlx_abliterate.direction."
+
+type directionalTarget struct {
+	Path            string   `json:"path"`
+	DirectionTensor string   `json:"direction_tensor"`
+	Strength        *float64 `json:"strength"`
+}
+type directionalConfig struct {
+	Version                int                 `json:"version"`
+	Method                 string              `json:"method"`
+	BaseContentFingerprint string              `json:"base_content_fingerprint"`
+	Targets                []directionalTarget `json:"targets"`
+}
+
+func directionalPaths(cfg *Config) map[string]bool {
+	paths := map[string]bool{}
+	for i := int32(0); i < cfg.NumHiddenLayers; i++ {
+		attention := "self_attn.o_proj"
+		if layerIsLinear(cfg, i) {
+			attention = "linear_attn.out_proj"
+		}
+		paths[fmt.Sprintf("model.layers.%d.%s", i, attention)] = true
+		paths[fmt.Sprintf("model.layers.%d.mlp.down_proj", i)] = true
+	}
+	return paths
+}
+
+func parseDirectionalConfig(data []byte, cfg *Config) (*directionalConfig, error) {
+	var top struct {
+		Architectures []string        `json:"architectures"`
+		Extension     json.RawMessage `json:"mlx_abliterate"`
+	}
+	if err := json.Unmarshal(data, &top); err != nil {
+		return nil, err
+	}
+	opted := len(top.Architectures) == 1 && top.Architectures[0] == directionalArchitecture
+	if !opted {
+		if len(top.Extension) > 0 {
+			return nil, fmt.Errorf("directional metadata requires explicit custom architecture")
+		}
+		return nil, nil
+	}
+	if len(top.Extension) == 0 || string(top.Extension) == "null" {
+		return nil, fmt.Errorf("missing directional metadata")
+	}
+	var ext directionalConfig
+	decoder := json.NewDecoder(bytes.NewReader(top.Extension))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&ext); err != nil {
+		return nil, fmt.Errorf("directional metadata: %w", err)
+	}
+	if ext.Version != 1 || ext.Method != "weight_only_rank_one" {
+		return nil, fmt.Errorf("unsupported directional schema or method")
+	}
+	fingerprint, err := hex.DecodeString(ext.BaseContentFingerprint)
+	if err != nil || len(fingerprint) != 32 || strings.ToLower(ext.BaseContentFingerprint) != ext.BaseContentFingerprint {
+		return nil, fmt.Errorf("invalid base content fingerprint")
+	}
+	if cfg.NumHiddenLayers != 64 || cfg.HiddenSize != 5120 || cfg.NumExperts != 0 {
+		return nil, fmt.Errorf("directional v1 requires dense 64-layer 5120-width target")
+	}
+	if len(ext.Targets) == 0 || len(ext.Targets) > 128 {
+		return nil, fmt.Errorf("directional target count must be 1..128")
+	}
+	allowed := directionalPaths(cfg)
+	seen := map[string]bool{}
+	tensors := map[string]bool{}
+	for _, target := range ext.Targets {
+		if !allowed[target.Path] || seen[target.Path] {
+			return nil, fmt.Errorf("invalid or repeated directional target %q", target.Path)
+		}
+		if target.Strength == nil || math.IsNaN(*target.Strength) || math.IsInf(*target.Strength, 0) || *target.Strength < 0 || *target.Strength > 2 {
+			return nil, fmt.Errorf("invalid directional strength")
+		}
+		index, err := strconv.Atoi(strings.TrimPrefix(target.DirectionTensor, directionTensorPrefix))
+		if err != nil || index < 0 || index >= 128 || target.DirectionTensor != directionTensorPrefix+strconv.Itoa(index) || tensors[target.DirectionTensor] {
+			return nil, fmt.Errorf("invalid or repeated direction tensor")
+		}
+		seen[target.Path] = true
+		tensors[target.DirectionTensor] = true
+	}
+	return &ext, nil
+}
+
+func (m *Model) applyDirectionalEdits(tensors map[string]*mlx.Array, modelPrefix string) error {
+	expected := map[string]bool{}
+	if m.directionalEdits != nil {
+		for _, t := range m.directionalEdits.Targets {
+			expected[t.DirectionTensor] = true
+		}
+	}
+	for name := range tensors {
+		if strings.HasPrefix(name, "mlx_abliterate.") && !expected[name] {
+			return fmt.Errorf("unpaired directional tensor %q", name)
+		}
+	}
+	if m.directionalEdits == nil {
+		return nil
+	}
+	// Build an explicit map solely from main decoder layers; MTP cannot enter it.
+	slots := map[string]*nn.LinearLayer{}
+	for i, layer := range m.Layers {
+		prefix := fmt.Sprintf("model.layers.%d.", i)
+		if layer.Linear != nil {
+			slots[prefix+"linear_attn.out_proj"] = &layer.Linear.OutProj
+		}
+		if layer.FullAttn != nil {
+			slots[prefix+"self_attn.o_proj"] = &layer.FullAttn.OProj
+		}
+		if dense, ok := layer.MLP.(*DenseMLP); ok {
+			slots[prefix+"mlp.down_proj"] = &dense.DownProj
+		}
+	}
+	// Validate/build all wrappers before mutating any slot.
+	wrappers := map[string]*nn.DirectionalLinear{}
+	for _, target := range m.directionalEdits.Targets {
+		slot := slots[target.Path]
+		if slot == nil || *slot == nil {
+			return fmt.Errorf("missing directional projection %q", target.Path)
+		}
+		base, ok := (*slot).(*nn.QuantizedLinear)
+		if !ok || base.Mode != "nvfp4" || base.Bits != 4 || base.GroupSize != 16 {
+			return fmt.Errorf("directional v1 requires NVFP4 group16 base at %q", target.Path)
+		}
+		actualPath := modelPrefix + strings.TrimPrefix(target.Path, "model.")
+		if tensors[actualPath+".weight"] == nil {
+			return fmt.Errorf("missing directional source weight %q", actualPath)
+		}
+		wrapper, err := nn.NewDirectionalLinear(*slot, tensors[target.DirectionTensor], float32(*target.Strength))
+		if err != nil {
+			return fmt.Errorf("directional target %s: %w", target.Path, err)
+		}
+		wrappers[target.Path] = wrapper
+	}
+	for i, layer := range m.Layers {
+		prefix := fmt.Sprintf("model.layers.%d.", i)
+		if layer.Linear != nil {
+			layer.AttentionDirection = wrappers[prefix+"linear_attn.out_proj"]
+		}
+		if layer.FullAttn != nil {
+			layer.AttentionDirection = wrappers[prefix+"self_attn.o_proj"]
+		}
+		layer.MLPDirection = wrappers[prefix+"mlp.down_proj"]
+	}
+	return nil
+}
diff --git a/mlxrunner/model/qwen3_5/directional_test.go b/mlxrunner/model/qwen3_5/directional_test.go
