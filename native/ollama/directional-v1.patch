@@ -0,0 +1,90 @@
+package qwen3_5
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/ollama/ollama/mlx"
+	"github.com/ollama/ollama/mlxrunner/model"
+)
+
+func TestDirectionalSchemaAdmission(t *testing.T) {
+	cfg := &Config{NumHiddenLayers: 64, HiddenSize: 5120, FullAttentionInterval: 4}
+	valid := func() map[string]any {
+		return map[string]any{"architectures": []string{directionalArchitecture}, "mlx_abliterate": map[string]any{"version": 1, "method": "weight_only_rank_one", "base_content_fingerprint": strings.Repeat("a", 64), "targets": []any{map[string]any{"path": "model.layers.0.linear_attn.out_proj", "direction_tensor": "mlx_abliterate.direction.0", "strength": 1.575}}}}
+	}
+	cases := []struct {
+		name   string
+		change func(map[string]any)
+	}{
+		{"missing metadata", func(v map[string]any) { delete(v, "mlx_abliterate") }},
+		{"stock architecture", func(v map[string]any) { v["architectures"] = []string{"Qwen3_5ForConditionalGeneration"} }},
+		{"schema", func(v map[string]any) { v["mlx_abliterate"].(map[string]any)["version"] = 2 }},
+		{"unknown field", func(v map[string]any) { v["mlx_abliterate"].(map[string]any)["typo"] = 1 }},
+		{"fingerprint", func(v map[string]any) { v["mlx_abliterate"].(map[string]any)["base_content_fingerprint"] = "x" }},
+		{"missing strength", func(v map[string]any) {
+			delete(v["mlx_abliterate"].(map[string]any)["targets"].([]any)[0].(map[string]any), "strength")
+		}},
+		{"strength bounds", func(v map[string]any) {
+			v["mlx_abliterate"].(map[string]any)["targets"].([]any)[0].(map[string]any)["strength"] = 2.00000001
+		}},
+		{"mtp", func(v map[string]any) {
+			v["mlx_abliterate"].(map[string]any)["targets"].([]any)[0].(map[string]any)["path"] = "mtp.layers.0.mlp.down_proj"
+		}},
+		{"wrong attention", func(v map[string]any) {
+			v["mlx_abliterate"].(map[string]any)["targets"].([]any)[0].(map[string]any)["path"] = "model.layers.0.self_attn.o_proj"
+		}},
+		{"duplicate", func(v map[string]any) {
+			e := v["mlx_abliterate"].(map[string]any)
+			a := e["targets"].([]any)
+			e["targets"] = append(a, a[0])
+		}},
+		{"bad tensor", func(v map[string]any) {
+			v["mlx_abliterate"].(map[string]any)["targets"].([]any)[0].(map[string]any)["direction_tensor"] = "model.embed_tokens.weight"
+		}},
+	}
+	raw, _ := json.Marshal(valid())
+	parsed, err := parseDirectionalConfig(raw, cfg)
+	if err != nil || parsed == nil {
+		t.Fatalf("valid: %v", err)
+	}
+	if !model.SupportsArchitecture(directionalArchitecture) {
+		t.Fatal("custom architecture not registered")
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			v := valid()
+			tc.change(v)
+			raw, _ := json.Marshal(v)
+			if _, err := parseDirectionalConfig(raw, cfg); err == nil {
+				t.Fatal("accepted invalid extension")
+			}
+		})
+	}
+	if got, err := parseDirectionalConfig([]byte(`{"architectures":["Qwen3_5ForConditionalGeneration"]}`), cfg); err != nil || got != nil {
+		t.Fatal("ordinary config changed")
+	}
+	cfg.HiddenSize = 4096
+	if _, err := parseDirectionalConfig(raw, cfg); err == nil {
+		t.Fatal("accepted unsupported model shape")
+	}
+}
+
+func TestDirectionalTensorPairing(t *testing.T) {
+	m := &Model{}
+	if err := m.applyDirectionalEdits(map[string]*mlx.Array{"mlx_abliterate.direction.0": nil}, "model."); err == nil {
+		t.Fatal("ordinary model accepted extension tensor")
+	}
+	if err := m.applyDirectionalEdits(map[string]*mlx.Array{}, "model."); err != nil {
+		t.Fatal(err)
+	}
+	strength := 1.0
+	m.directionalEdits = &directionalConfig{Targets: []directionalTarget{{Path: "model.layers.0.mlp.down_proj", DirectionTensor: "mlx_abliterate.direction.0", Strength: &strength}}}
+	if err := m.applyDirectionalEdits(map[string]*mlx.Array{}, "model."); err == nil {
+		t.Fatal("accepted missing main layer")
+	}
+	if err := m.applyDirectionalEdits(map[string]*mlx.Array{"mlx_abliterate.direction.1": nil}, "model."); err == nil {
+		t.Fatal("accepted unpaired tensor")
+	}
+}
diff --git a/mlxrunner/nn/directional.go b/mlxrunner/nn/directional.go
new file mode 100644
index 0000000..5bbc21e
--- /dev/null
+++ b/mlxrunner/nn/directional.go
@@ -0,0 +1,84 @@
+package nn
+
+// Original experimental output-direction wrapper. Base weights remain packed.
+// Arithmetic order mirrors mlx_abliterate.edits.DirectionalProjection.
+import (
+	"fmt"
+	"math"
+
+	"github.com/ollama/ollama/mlx"
+)
+
+type DirectionalLinear struct {
+	Base      LinearLayer
+	Direction *mlx.Array
+	Strength  float32
+	Bias      *mlx.Array
+	Scale     *mlx.Array
+}
+
+// ValidateUnitDirection runs without MLX and rejects corrupt extension data.
+func ValidateUnitDirection(values []float32, width int) error {
+	if len(values) != width || width == 0 {
+		return fmt.Errorf("direction width mismatch")
+	}
+	norm := float64(0)
+	for _, v := range values {
+		if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+			return fmt.Errorf("direction must be finite")
+		}
+		norm += float64(v) * float64(v)
+	}
+	if math.Abs(math.Sqrt(norm)-1) > 1e-5 {
+		return fmt.Errorf("direction must have unit norm")
+	}
+	return nil
+}
+
+func NewDirectionalLinear(base LinearLayer, direction *mlx.Array, strength float32) (*DirectionalLinear, error) {
+	if base == nil || direction == nil {
+		return nil, fmt.Errorf("missing directional base or tensor")
+	}
+	if math.IsNaN(float64(strength)) || math.IsInf(float64(strength), 0) || strength < 0 || strength > 2 {
+		return nil, fmt.Errorf("invalid directional strength")
+	}
+	if direction.DType() != mlx.DTypeFloat32 || direction.NumDims() != 1 || direction.Dim(0) != int(base.OutputDim()) {
+		return nil, fmt.Errorf("direction must be FP32 output-width vector")
+	}
+	if err := ValidateUnitDirection(direction.Floats(), int(base.OutputDim())); err != nil {
+		return nil, err
+	}
+	var bias *mlx.Array
+	switch b := base.(type) {
+	case *Linear:
+		bias = b.Bias
+	case *QuantizedLinear:
+		bias = b.Bias // QBiases are quantization offsets, never ordinary bias.
+	default:
+		return nil, fmt.Errorf("unsupported directional base %T", base)
+	}
+	if bias != nil && (bias.NumDims() != 1 || bias.Dim(0) != int(base.OutputDim())) {
+		return nil, fmt.Errorf("ordinary bias width mismatch")
+	}
+	// Match Python's normalization, including the second normalization of an
+	// already approximately unit spec vector. Never normalize in float64.
+	scaled := direction.Divide(direction.Abs().MaxAxis(0, false))
+	normalized := scaled.Divide(scaled.Multiply(scaled).SumAxis(0, false).Sqrt())
+	mlx.Eval(normalized)
+	return &DirectionalLinear{Base: base, Direction: normalized, Strength: strength, Bias: bias, Scale: mlx.NewScalarArray(strength)}, nil
+}
+
+func (l *DirectionalLinear) OutputDim() int32 { return l.Base.OutputDim() }
+func (l *DirectionalLinear) Forward(x *mlx.Array) *mlx.Array {
+	output := l.Base.Forward(x)
+	if l.Strength == 0 {
+		return output
+	}
+	value := output.AsType(mlx.DTypeFloat32)
+	if l.Bias != nil {
+		value = value.Subtract(l.Bias.AsType(mlx.DTypeFloat32))
+	}
+	coefficient := value.Multiply(l.Direction).SumAxis(-1, true)
+	correction := l.Scale.Multiply(coefficient).Multiply(l.Direction).AsType(output.DType())
+	return output.Subtract(correction)
+}
